# ---------------------------------------------------------------------------
# NEXUS environment variables
# Copy to .env.local for local development. In Vercel, add these under
# Project → Settings → Environment Variables (Production + Preview).
# Never commit real values.
# ---------------------------------------------------------------------------

# --- Supabase (required) ----------------------------------------------------
# Project URL: Supabase dashboard → Project Settings → API (or "Connect").
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Browser-safe key. Use the publishable key (sb_publishable_...) or, on older
# projects, the legacy anon key via NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the deployment, used in auth email links (sign-up
# confirmation, password reset). Optional locally; set it in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: NEXUS does not need SUPABASE_SERVICE_ROLE_KEY. Every query runs as the
# signed-in user under Row Level Security, and account deletion uses a
# SECURITY DEFINER function limited to the caller's own account.

# --- AI answer generation (server only) --------------------------------------
# Either provider works; NEXUS recognises the key format automatically.
#  - Groq (free tier, no card): console.groq.com → API Keys → key starts with gsk_
#  - Anthropic Claude (paid):   console.anthropic.com → key starts with sk-ant-
# Without a key, AI Recall still returns matching memories as sources but
# doesn't write an answer, and voice "Extract key information" is disabled.
AI_PROVIDER_API_KEY=
# Optional: force the provider (groq | anthropic) instead of detecting it.
# AI_PROVIDER=groq
# Optional model override. Defaults: openai/gpt-oss-120b (Groq),
# claude-opus-5-5 (Anthropic).
# AI_MODEL=
# Reasoning effort: low | medium | high | xhigh | max. Default: medium
AI_EFFORT=medium

# --- Embeddings for semantic search (server only) ----------------------------
# voyage (default) or openai. Both are configured to return 1024-dimensional
# vectors to match the vector(1024) column in the migration.
EMBEDDING_PROVIDER=voyage
# Voyage AI key (dash.voyageai.com) or OpenAI key, matching EMBEDDING_PROVIDER.
# Without it, memories are saved and keyword search works, but semantic
# search is disabled and memories show "Indexing failed" until you add a key
# and retry indexing from Settings.
EMBEDDING_API_KEY=
# Default: voyage-3.5 (voyage) or text-embedding-3-small (openai).
# Must support 1024-dimensional output.
EMBEDDING_MODEL=voyage-3.5
